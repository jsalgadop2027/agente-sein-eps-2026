# Plantilla de variables para ejecutar GenEPS en local.
# Copiar a .env (no se sube al repo) y completar:  cp .env.example .env
# Arranque:  uvicorn src.main:app --env-file .env --reload   (requiere python-dotenv)
# En Cloud Run estas variables las define deploy.sh desde Secret Manager.

# --- Obligatoria ---
ANTHROPIC_API_KEY=

# --- Acceso a la interfaz web ---
GENEPS_USER=geneps
# Vacío = sin login en local; con valor, la app pide usuario/contraseña
GENEPS_PASSWORD=

# --- Modelo (valores por defecto) ---
GENEPS_MODEL=claude-opus-5-5
GENEPS_EFFORT=high
# 0 = desactiva el ajuste automático de esfuerzo
GENEPS_EFFORT_ROUTING=1

# --- Almacenamiento ---
# Por defecto guarda en disco local
LOCAL_STORE=.store
# Si se define, usa el bucket de GCS (requiere gcloud auth application-default login)
# GCS_BUCKET=agente-sein-eps-2026-geneps-us
